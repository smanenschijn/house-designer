{
  "name": "house-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"API_PORT=8787 tsx watch --env-file-if-exists=.env src/server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "API_PORT=8787 tsx watch --env-file-if-exists=.env src/server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env src/server/index.ts",
    "user:add": "tsx src/server/cli-add-user.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@simplewebauthn/server": "^14.1.0",
    "hono": "^4.13.17",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "zustand": "^5.1.0"
  }
}
