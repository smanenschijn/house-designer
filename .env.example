# Eerste account, alleen gebruikt als er nog geen gebruikers zijn (minstens 10 tekens).
# Daarna maak je in de app (Account → Gebruikers) extra gebruikers aan.
ADMIN_USERNAME=stefan
ADMIN_DISPLAY_NAME=Stefan
ADMIN_PASSWORD=kies-een-sterk-wachtwoord
# Publieke URL van de site; bepaalt het domein voor passkeys en of cookies 'secure' zijn
PUBLIC_URL=https://huis.example.nl
# Map voor de SQLite-database
DATA_DIR=data
PORT=8787
